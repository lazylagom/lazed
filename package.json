{
  "name": "lazed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "tsc --noEmit && biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "fetch-herdr": "sh scripts/fetch-herdr",
    "stage-lazed": "sh scripts/stage-lazed",
    "dist": "bun run stage-lazed && tauri build --config src-tauri/tauri.bundle.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.0"
  }
}
