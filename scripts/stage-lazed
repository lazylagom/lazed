#!/bin/sh
# Stage the lazed daemon binary into src-tauri/ so `tauri build` can
# bundle it via bundle.resources:
#   src-tauri/bin/lazed    → Contents/Resources/bin/lazed (daemon + CLI)
set -eu
cd "$(dirname "$0")/.."

cargo build --release --manifest-path daemon/Cargo.toml

mkdir -p src-tauri/bin
cp daemon/target/release/lazed src-tauri/bin/lazed
chmod +x src-tauri/bin/lazed

echo "stage-lazed: bundled daemon"
