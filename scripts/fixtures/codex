#!/usr/bin/env python3
"""Offline interactive-agent fixture. Never calls a provider."""
import json
import os
import socket
import sys
import time
import tty
from pathlib import Path

tty.setraw(0)
time.sleep(0.3)
seq = 0


def paint(text):
    os.write(1, ("\x1b[?2004h\x1b[2J\x1b[H" + text).encode())


def report(state):
    global seq
    seq += 1
    with socket.socket(socket.AF_UNIX) as conn:
        conn.connect(str(Path(os.environ["LAZED_STATE_DIR"]) / "lazed.sock"))
        conn.sendall((json.dumps({"id": 1, "method": "agent.report", "params": {
            "term_id": os.environ["LAZED_TERM"], "launch_id": os.environ["LAZED_LAUNCH_ID"],
            "seq": seq, "state": state,
        }}) + "\n").encode())
        conn.recv(65536)


if "--blocked" in sys.argv:
    paint("Do you trust this folder?\n1. Yes (enter to confirm)")
    approval = b""
    while not approval.endswith(b"\r"):
        approval += os.read(0, 1)
    if approval != b"1\r":
        sys.exit(3)
paint("› ")
buf = b""
while True:
    char = os.read(0, 1)
    if not char:
        break
    if char == b"\x03":
        sys.exit(0)
    if char != b"\r":
        buf += char
        continue
    text = buf.removeprefix(b"\x1b[200~").removesuffix(b"\x1b[201~").decode()
    buf = b""
    with open("received.jsonl", "a") as log:
        log.write(json.dumps(text, ensure_ascii=False) + "\n")
    if "--silent" in sys.argv:
        continue
    if "--fast" in sys.argv:
        report("working")
        report("idle")
        continue
    paint("Working (esc to interrupt)\n› ")
    time.sleep(1.5)
    paint("Response ended\n› ")
