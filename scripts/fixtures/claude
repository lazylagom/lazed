#!/usr/bin/env python3
"""Offline full-screen agent with a mouse-scrollable transcript."""
import os
import re
import sys
import time
import tty

tty.setraw(0)
time.sleep(0.3)
height = os.get_terminal_size().lines
visible = height - 3
last = 90 - visible
offset = last - (6 if "--scrolled" in sys.argv else 0)


def paint():
    lines = ["Transcript fixture"]
    lines.extend(f"history-row-{i:03d} 한글 response" for i in range(offset, offset + visible))
    lines.extend(["", "❯ "])
    os.write(1, ("\x1b[?1049h\x1b[?1000h\x1b[?1006h\x1b[?2004h\x1b[2J\x1b[H" + "\r\n".join(lines)).encode())


paint()
buf = b""
while True:
    char = os.read(0, 1)
    if not char or char == b"\x03":
        break
    buf += char
    match = re.search(rb"\x1b\[<(64|65);\d+;\d+M$", buf)
    if match:
        delta = -1 if match[1] == b"64" else 1
        offset = max(0, min(last, offset + delta))
        paint()
        buf = b""
