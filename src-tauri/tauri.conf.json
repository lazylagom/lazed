{
  "$schema": "https://raw.githubusercontent.com/nicedouble/tauri-apps/main/tauri-conf-v2.schema.json",
  "productName": "lazed",
  "version": "0.0.1",
  "identifier": "com.lazed.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "lazed",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "GUI client for the lazed workspace daemon",
    "longDescription": "lazed - a desktop GUI front-end for lazed terminal workspaces"
  }
}
